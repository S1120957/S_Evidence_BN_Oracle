# Copy this file to .env and fill in your own values.
# NEVER commit the real .env (it is gitignored).

# Sepolia RPC endpoint (e.g. Alchemy, Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployer/oracle wallet private key (64 hex chars, no 0x prefix)
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Deployed contract addresses (filled after `truffle migrate`)
CPTSTORE_ADDR=0x...
CLAIMREGISTRY_ADDR=0x...
EVIDENCEREGISTRY_ADDR=0x...
ORACLECONTROLLER_ADDR=0x...

# Experiment profile: neutral | asymmetric
PROFILE_NAME=neutral
